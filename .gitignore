# Implementation plans are local-only, ephemeral work artifacts (see docs/plans/README.md).
# They go stale the moment code merges; the durable "why" lives in docs/specs/ + docs/adrs/,
# and the durable "what happened" in docs/reports/. CI enforces this
# (scripts/check-no-committed-plans.sh) because this rule alone is advisory.
docs/plans/*
!docs/plans/README.md

# Claude Code local config. Keep this: in a sandboxed setup the launcher copies global
# settings -- which can carry tokens -- into the project's .claude/.
.claude/

# Secrets and credentials
.env
.env.*
.env.local
*.key
*.pem
*.p12
credentials.*
secrets.*
*kubeconfig*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# --- Add your language's ignores below ---
# Node:   node_modules/ dist/ *.log
# Python: __pycache__/ .venv/ *.egg-info/
# Go:     /bin/ go.work.sum
